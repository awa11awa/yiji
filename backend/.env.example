# Run from backend/. Load this file with your process manager or --env-file.
# Without MODEL_API_KEY, local rule extraction is used.
YIJI_ACCESS_TOKEN=replace-with-a-long-random-service-token
MODEL_BASE_URL=https://your-provider.example/v1
MODEL_API_KEY=
MODEL_NAME=
# On a private local network, bind to 0.0.0.0 explicitly when needed.
# Phone service URL: http://<computer-LAN-IP>:8000 (debug APK only)
